// Windows resources for aether_studio.exe: application icon + VERSIONINFO (configured by CMake).
#include <winres.h>

101 ICON "@AETHER_APP_ICON@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "AiChan277"
            VALUE "FileDescription", "AETHER-2.5D Studio - real-time 2.5D VTuber studio"
            VALUE "FileVersion", "@PROJECT_VERSION@.0"
            VALUE "InternalName", "aether_studio"
            VALUE "LegalCopyright", "Copyright (c) 2026 Rachel (AiChan277). Source-available license."
            VALUE "OriginalFilename", "aether_studio.exe"
            VALUE "ProductName", "AETHER-2.5D Studio"
            VALUE "ProductVersion", "@AETHER_RELEASE_TAG@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
