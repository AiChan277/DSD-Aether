        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "AiChan277"
            VALUE "FileDescription", "AETHER-2.5D Virtual Camera DirectShow Filter (@AETHER_VCAM_ARCH@)"
            VALUE "FileVersion", "@AETHER_VCAM_VER_STR@"
            VALUE "InternalName", "aether_vcam_ds_@AETHER_VCAM_ARCH@"
            VALUE "LegalCopyright", "Copyright (c) 2026 Rachel (AiChan277). Source-available license."
            VALUE "OriginalFilename", "aether_vcam_ds_@AETHER_VCAM_ARCH@.dll"
            VALUE "ProductName", "AETHER-2.5D Studio"
            VALUE "ProductVersion", "@AETHER_RELEASE_TAG@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
