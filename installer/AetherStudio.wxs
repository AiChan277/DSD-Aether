<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="AETHER-2.5D Studio"
      Manufacturer="AETHER-2.5D Contributors"
      Version="0.1.0.0"
      UpgradeCode="94B2E5C1-3A48-4C7A-9E6D-1F2A84B70E91"
      Scope="perMachine"
      InstallerVersion="500">

    <MajorUpgrade
        DowngradeErrorMessage="A newer version of [ProductName] is already installed."
        AllowSameVersionUpgrades="yes" />

    <MediaTemplate EmbedCab="yes" CompressionLevel="mszip" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="AETHER-2.5D Studio">
        <Directory Id="VCAMFOLDER" Name="vcam" />
        <Directory Id="MODELSFOLDER" Name="models" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="AETHER-2.5D Studio" />
    </StandardDirectory>

    <ComponentGroup Id="CoreAppComponents" Directory="INSTALLFOLDER">
      <Component Id="AetherStudioExe" Guid="E129B7B2-6F08-4F6F-B2A7-42B646D8A401" Bitness="always64">
        <File
            Id="AetherStudioMainExe"
            Source="$(var.StageDir)\aether_studio.exe"
            KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="RuntimeFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.StageDir)\*.dll" />
    </ComponentGroup>

    <!-- Dual x64 & x86 DirectShow Virtual Camera filter registration (CLSID_AetherVirtualCam) -->
    <ComponentGroup Id="VirtualCamComponents" Directory="VCAMFOLDER">
      <Component Id="VcamX64Component" Guid="C8C5726D-0F66-46B7-8CE8-55B34E10F902" Bitness="always64">
        <File
            Id="VcamX64Dll"
            Name="aether_vcam_ds_x64.dll"
            Source="$(var.VcamX64Dll)"
            KeyPath="yes" />
        <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\CLSID\{7A5E14B2-4F8C-4D31-9E2A-61B38F0C42D5}">
          <RegistryValue Type="string" Value="Aether 2.5D Virtual Cam (Alpha)" />
          <RegistryKey Key="InprocServer32">
            <RegistryValue Type="string" Value="[#VcamX64Dll]" />
            <RegistryValue Name="ThreadingModel" Type="string" Value="Both" />
          </RegistryKey>
        </RegistryKey>
      </Component>

      <Component Id="VcamX86Component" Guid="D91B41E3-552C-4E19-A2F1-8F0010D9E903" Bitness="always32">
        <File
            Id="VcamX86Dll"
            Name="aether_vcam_ds_x86.dll"
            Source="$(var.VcamX86Dll)"
            KeyPath="yes" />
        <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\WOW6432Node\CLSID\{7A5E14B2-4F8C-4D31-9E2A-61B38F0C42D5}">
          <RegistryValue Type="string" Value="Aether 2.5D Virtual Cam (Alpha)" />
          <RegistryKey Key="InprocServer32">
            <RegistryValue Type="string" Value="[#VcamX86Dll]" />
            <RegistryValue Name="ThreadingModel" Type="string" Value="Both" />
          </RegistryKey>
        </RegistryKey>
      </Component>
    </ComponentGroup>

    <!-- Elevated regsvr32 calls for IFilterMapper2 Video Capture Source Category registration -->
    <CustomAction
        Id="RegisterVcamX64"
        Directory="VCAMFOLDER"
        ExeCommand="&quot;[System64Folder]regsvr32.exe&quot; /s &quot;[#VcamX64Dll]&quot;"
        Execute="deferred"
        Impersonate="no"
        Return="check" />

    <CustomAction
        Id="UnregisterVcamX64"
        Directory="VCAMFOLDER"
        ExeCommand="&quot;[System64Folder]regsvr32.exe&quot; /u /s &quot;[#VcamX64Dll]&quot;"
        Execute="deferred"
        Impersonate="no"
        Return="ignore" />

    <CustomAction
        Id="RegisterVcamX86"
        Directory="VCAMFOLDER"
        ExeCommand="&quot;[SystemFolder]regsvr32.exe&quot; /s &quot;[#VcamX86Dll]&quot;"
        Execute="deferred"
        Impersonate="no"
        Return="check" />

    <CustomAction
        Id="UnregisterVcamX86"
        Directory="VCAMFOLDER"
        ExeCommand="&quot;[SystemFolder]regsvr32.exe&quot; /u /s &quot;[#VcamX86Dll]&quot;"
        Execute="deferred"
        Impersonate="no"
        Return="ignore" />

    <ComponentGroup Id="ShortcutComponents" Directory="ApplicationProgramsFolder">
      <Component Id="StartMenuShortcut" Guid="A45E12E8-E821-4B08-A961-99D05A3DF904" Bitness="always64">
        <Shortcut
            Id="AetherStartShortcut"
            Name="AETHER-2.5D Studio"
            Description="Real-time 2.5D NPR VTuber Studio Engine"
            Target="[#AetherStudioMainExe]"
            WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="CleanAppProgramsFolder" Directory="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\AETHER25D\Studio" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <InstallExecuteSequence>
      <Custom Action="RegisterVcamX64" After="InstallFiles" Condition="NOT Installed" />
      <Custom Action="RegisterVcamX86" After="RegisterVcamX64" Condition="NOT Installed" />
      <Custom Action="UnregisterVcamX64" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot;" />
      <Custom Action="UnregisterVcamX86" Before="UnregisterVcamX64" Condition="REMOVE=&quot;ALL&quot;" />
    </InstallExecuteSequence>

    <Feature Id="ProductFeature" Title="AETHER-2.5D Studio" Level="1">
      <ComponentGroupRef Id="CoreAppComponents" />
      <ComponentGroupRef Id="RuntimeFiles" />
      <ComponentGroupRef Id="VirtualCamComponents" />
      <ComponentGroupRef Id="ShortcutComponents" />
    </Feature>
  </Package>
</Wix>
